# Copy to .env and adjust. All variables use the RM_ prefix.

# REQUIRED in production: a long random string, e.g. `openssl rand -hex 48`
RM_SECRET_KEY=change-me

RM_ENVIRONMENT=production
RM_APP_NAME=VulnFlow

# Database password (Docker). Use letters and digits only, e.g. `openssl rand -hex 24`.
# docker-compose builds RM_DATABASE_URL and RM_REDIS_URL from this automatically.
POSTGRES_PASSWORD=change-me-too

# Without Docker, point these at your own PostgreSQL and Redis instead:
# RM_DATABASE_URL=postgresql+psycopg://report_manager:PASSWORD@localhost:5432/report_manager
# RM_REDIS_URL=redis://localhost:6379/0

# Session cookies require HTTPS when true (recommended behind TLS).
# Set to false if you open the app over plain http://, or sign-in will not stick.
RM_COOKIE_SECURE=true
RM_ACCESS_TOKEN_MINUTES=15
RM_REFRESH_TOKEN_DAYS=7

# Account lockout & password policy
RM_MAX_FAILED_LOGINS=5
RM_MAX_FAILED_LOGINS_PER_IP=20
RM_LOCKOUT_MINUTES=15
RM_PASSWORD_MIN_LENGTH=12

# Largest .nessus upload accepted (MB). Keep nginx client_max_body_size in sync.
RM_MAX_UPLOAD_MB=1024

# Host port the web UI is published on
HTTP_PORT=8080
